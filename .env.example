# SkyBox - Environment Configuration
# Replace these with your actual project credentials from the Supabase Dashboard:
# Project Settings -> API (URL and anon/public key)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Publishable Key (New format)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_...

# Base Application URL for OAuth and email redirects (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
